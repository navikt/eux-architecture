{
  "name": "eux-architecture-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "search:index": "node scripts/search-index.mjs",
    "predev": "pnpm search:index",
    "dev": "next dev",
    "prebuild": "pnpm search:index",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "pnpm search:index",
    "typecheck": "tsc --noEmit",
    "test": "pnpm search:index && node --experimental-strip-types --import ./scripts/resolve-ts.mjs --test scripts/*.test.mjs",
    "test:search": "pnpm search:index && node --experimental-strip-types --import ./scripts/resolve-ts.mjs --test scripts/search.test.mjs",
    "test:data": "node --experimental-strip-types --import ./scripts/resolve-ts.mjs --test scripts/data.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.18.0",
    "@navikt/ds-css": "8.18.0",
    "@navikt/ds-react": "8.18.0",
    "@navikt/next-logger": "5.0.1",
    "next": "16.3.8",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.3.8",
    "typescript": "7.0.2"
  }
}
